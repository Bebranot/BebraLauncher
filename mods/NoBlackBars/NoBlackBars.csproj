<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NoBlackBars</AssemblyName>
    <RootNamespace>NoBlackBars</RootNamespace>

    <!-- Папка с собранным клиентом игры. Можно переопределить:
         dotnet build -c Release -p:GameDir="D:\SS14\bin\Content.Client" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\LocalDutyAVS\bin\Content.Client</GameDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(USERPROFILE)\.nuget\packages\lib.harmony\2.4.3\lib\net10.0</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony уже загружена лаунчером в процесс игры, поэтому копировать её в выход не нужно. -->
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Ссылки только для компиляции: в рантайме используются сборки самого клиента. -->
    <Reference Include="Content.Client">
      <HintPath>$(GameDir)\Content.Client.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Content.Shared">
      <HintPath>$(GameDir)\Content.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Robust.Client">
      <HintPath>$(GameDir)\Robust.Client.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Robust.Shared">
      <HintPath>$(GameDir)\Robust.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Robust.Shared.Maths">
      <HintPath>$(GameDir)\Robust.Shared.Maths.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
