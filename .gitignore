# --- Rust ---
/target/
**/*.rs.bk

# --- Node / frontend ---
node_modules/
dist/
.svelte-kit/

# --- Tauri ---
app/src-tauri/target/
app/src-tauri/gen/

# --- Local runtime data (launcher data dir, DBs, logs) ---
*.db
*.db-wal
*.db-shm
*.log
.env
.env.*

# --- IDE / OS ---
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Claude / AI tooling (keep out of the repo) ---
.claude/
.claude-mem/
.codegraph/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
NOTES.md
.mcp.json
# Markdown: the project documentation belongs to the repository, so a fresh clone has the
# protocol, the design notes and the changelog rules. Private agent notes (CLAUDE.md,
# AGENTS.md, .mcp.json) stay ignored by the rules above.
*.md
!README.md
!CHANGELOG.md
!PRODUCT.md
!NOTES.md
!docs/**/*.md

# signing keys never go to the repository
*.key

# --- .NET build output (loader) ---
bin/
obj/
loader/out*/
