<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Windows-only and needed by the release publish; listing it here also writes the RID into
         packages.lock.json, so a locked restore works for the self-contained publish too. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <!-- Fixed instead of "latest": the language version must not change when the SDK on the
         build machine changes, or an old SDK stops compiling the same sources. -->
    <LangVersion>13.0</LangVersion>
    <!-- One lock file per project, committed; CI restores in locked mode so that a changed
         dependency graph is a red build instead of a silent version drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Same as the official launcher: CET breaks some older but supported Windows versions. -->
    <CETCompat>false</CETCompat>
    <!-- NuGet audit warnings about known vulnerabilities must break the build, not scroll by. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
