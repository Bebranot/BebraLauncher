<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Robust.LoaderApi\Robust.LoaderApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored from the official launcher's source tree, copied into ../Shared. Only the files
         that are actually used are compiled: ZStd.cs and Libc.cs stay on disk as reference but
         their unused classes (and the module initializer) must not end up in the binary. -->
    <Compile Include="..\Shared\ContentCompressionScheme.cs" />
    <Compile Include="..\Shared\SqliteBlobStream.cs" />
    <Compile Include="..\Shared\ZStdException.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="NSec.Cryptography" />
    <!-- libsodium is listed explicitly to control its version. -->
    <PackageReference Include="libsodium" />
    <PackageReference Include="Robust.Natives" />
    <PackageReference Include="Robust.Natives.Zstd" />
    <PackageReference Include="SharpZstd.Interop" ExcludeAssets="native" />
  </ItemGroup>

</Project>
